---
layout: null
permalink: /assets/search-index.json
search: exclude
sitemap: false
---
{% assign counter = 0 %}{
  "authorNames": [{% for author in site.authors %}{{ author.title | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "documents": [{% for book in site.books %}{% assign search_cover = book.image %}{% if book.ean %}{% include ean-cover-resolve.html ean=book.ean %}{% if ean_cover_available %}{% assign search_cover = ean_cover_src %}{% endif %}{% endif %}{
    "id": {{ counter }},
    "url": "{{ site.url }}{{ site.baseurl }}{{ book.url }}",
    "title": {{ book.title | jsonify }},
    "image": "{{ site.url }}{{ site.baseurl }}/{{ search_cover }}",
    "authors": {% capture book_authors %}{% for author_slug in book.authors %}{% assign author = site.authors | where: "key", author_slug | first %}{% if author %}{{ author.title }}{% else %}{{ author_slug }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endcapture %}{{ book_authors | strip | jsonify }},
    "categories": {{ book.categories | join: ', ' | jsonify }},
    "grades": {{ book.grades | join: ', ' | jsonify }},
    "ean": {{ book.ean | append: '' | jsonify }},
    "genre": {% if book.genre == 'education' %}"Eğitim"{% elsif book.genre == 'story' %}"Hikaye"{% else %}{{ book.genre | jsonify }}{% endif %},
    "anatema": {{ book.anatema | join: ', ' | jsonify }},
    "degerler": {{ book.degerler | join: ', ' | jsonify }},
    "egilimler": {{ book.egilimler | join: ', ' | jsonify }},
    "kazanim": {{ book.kazanim | join: ', ' | jsonify }},
    "beceriler": {{ book.beceriler | join: ', ' | jsonify }},
    "unite": {{ book.unite | join: ', ' | jsonify }},
    "tags": {{ book.tags | join: ', ' | jsonify }},
    "body": {{ book.content | markdownify | replace: '.', '. ' | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | replace: '</p>', ' ' | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}{% assign counter = counter | plus: 1 %}
  }{% unless forloop.last %},{% endunless %}{% endfor %}{% if site.bundles %}{% if site.bundles.size > 0 %}{% if site.books.size > 0 %},{% endif %}{% for bundle in site.bundles %}{% assign search_cover = bundle.image %}{% assign bundle_cover_ean = bundle.ean %}{% unless bundle_cover_ean %}{% for ean in bundle.eans %}{% assign ean_s = ean | append: '' %}{% for book in site.books %}{% assign book_ean_s = book.ean | append: '' %}{% if book_ean_s == ean_s %}{% assign bundle_cover_ean = book.ean %}{% break %}{% endif %}{% endfor %}{% if bundle_cover_ean %}{% break %}{% endif %}{% endfor %}{% endunless %}{% if bundle_cover_ean %}{% include ean-cover-resolve.html ean=bundle_cover_ean %}{% if ean_cover_available %}{% assign search_cover = ean_cover_src %}{% endif %}{% endif %}{
    "id": {{ counter }},
    "url": "{{ site.url }}{{ site.baseurl }}{{ bundle.url }}",
    "title": {{ bundle.title | jsonify }},
    "image": "{{ site.url }}{{ site.baseurl }}/{{ search_cover }}",
    "authors": "",
    "categories": "Paket",
    "grades": {{ bundle.grades | join: ', ' | jsonify }},
    "ean": {{ bundle.eans | join: ' ' | jsonify }},
    "genre": "Paket",
    "anatema": "",
    "degerler": "",
    "egilimler": "",
    "kazanim": "",
    "beceriler": "",
    "unite": "",
    "tags": "paket",
    "body": {{ bundle.content | markdownify | replace: '.', '. ' | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | replace: '</p>', ' ' | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}{% assign counter = counter | plus: 1 %}
  }{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}{% endif %}]
}
