---
layout: null
permalink: /assets/search-index.json
search: exclude
sitemap: false
---
{% assign counter = 0 %}{
  "authorNames": [{% for author in site.authors %}{{ author.title | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "documents": [{% for book in site.books %}{% assign search_cover = book.image %}{% if book.ean %}{% assign book_cover_jpg = 'assets/images/ean/' | append: book.ean | append: '.jpg' %}{% assign book_cover_webp = 'assets/images/ean/' | append: book.ean | append: '.webp' %}{% assign book_cover_has_jpg = false %}{% assign book_cover_has_webp = false %}{% assign book_cover_jpg_rel = '/' | append: book_cover_jpg %}{% assign book_cover_webp_rel = '/' | append: book_cover_webp %}{% for static_file in site.static_files %}{% if static_file.path == book_cover_jpg_rel %}{% assign book_cover_has_jpg = true %}{% endif %}{% if static_file.path == book_cover_webp_rel %}{% assign book_cover_has_webp = true %}{% endif %}{% endfor %}{% if book_cover_has_webp %}{% assign search_cover = book_cover_webp %}{% elsif book_cover_has_jpg %}{% assign search_cover = book_cover_jpg %}{% endif %}{% endif %}{
    "id": {{ counter }},
    "url": "{{ site.url }}{{ site.baseurl }}{{ book.url }}",
    "title": {{ book.title | jsonify }},
    "image": "{{ site.url }}{{ site.baseurl }}/{{ search_cover }}",
    "authors": {% capture book_authors %}{% for author_slug in book.authors %}{% assign author = site.authors | where: "key", author_slug | first %}{% if author %}{{ author.title }}{% else %}{{ author_slug }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endcapture %}{{ book_authors | strip | jsonify }},
    "categories": {{ book.categories | join: ', ' | jsonify }},
    "grades": {{ book.grades | join: ', ' | jsonify }},
    "ean": {{ book.ean | append: '' | jsonify }},
    "genre": {% if book.genre == 'education' %}"Eğitim"{% elsif book.genre == 'story' %}"Hikaye"{% else %}{{ book.genre | jsonify }}{% endif %},
    "anatemalar": {{ book.anatemalar | join: ', ' | jsonify }},
    "tags": {{ book.tags | join: ', ' | jsonify }},
    "body": {{ book.content | markdownify | replace: '.', '. ' | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</h4>', ': ' | replace: '</p>', ' ' | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}{% assign counter = counter | plus: 1 %}
  }{% unless forloop.last %},{% endunless %}{% endfor %}]
}
